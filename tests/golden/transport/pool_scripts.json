        {
          "op": "path",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": true,
          "path": {
            "direct": true,
            "rtt_ns": "1000000"
          }
        },
        {
          "op": "drop",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": true
        },
        {
          "op": "path",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": false
        },
        {
          "op": "get",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": true,
          "conn": 1,
          "dial_attempts": 2,
          "dials": 2
        },
        {
          "op": "close",
          "ok": true
        },
        {
          "op": "path",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": false
        },
        {
          "op": "get",
          "peer": "a",
