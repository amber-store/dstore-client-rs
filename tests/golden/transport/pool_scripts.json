    {
      "name": "failed_dial_window",
      "description": "A failed dial with no live connection refuses further dials for 2 s without dialing.",
      "per_peer": 2,
      "nodes": [
        {
          "name": "client",
          "id": "4bb675de4f6376ab61737033d701560e4434be1d6736562ae29b8835b763cd24",
          "bound": true,
          "alpns": [],
          "server": null
        },
        {
          "name": "a",
          "id": "62297a9a3f36e80f3a2f2e0fccbba10a22878df1907f64c67519e9860a87c944",
          "bound": true,
          "alpns": [
            "amber-dstore/1"
          ],
          "server": {
            "mode": "none"
          }
        }
      ],
      "steps": [
        {
          "op": "set_down",
          "peer": "a",
          "down": true,
          "ok": true
        },
        {
          "op": "get",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": false,
          "error": "mem: 62297a9a unreachable",
          "dial_attempts": 1,
          "dials": 0
        },
        {
          "op": "get",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": false,
          "error": "transport: peer recently unreachable",
          "dial_attempts": 1,
          "dials": 0
        },
        {
          "op": "set_down",
          "peer": "a",
          "down": false,
          "ok": true
        },
        {
          "op": "get",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": false,
          "error": "transport: peer recently unreachable",
          "dial_attempts": 1,
          "dials": 0
        },
        {
          "op": "sleep",
          "ms": 2100,
          "ok": true
        },
        {
          "op": "get",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": true,
          "conn": 0,
          "dial_attempts": 2,
          "dials": 1
        },
        {
          "op": "get",
          "peer": "a",
          "alpn": "amber-dstore/1",
          "ok": true,
          "conn": 1,
          "dial_attempts": 3,
          "dials": 2
        }
      ]
